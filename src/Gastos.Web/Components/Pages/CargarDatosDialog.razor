@inject ICargaService CargaService
@inject ICatalogoService Catalogos
@inject SesionUsuario Sesion
@inject ISnackbar Snackbar

@* Diálogo "Cargar datos" (solo Administrador). Origen: Repsol o Moeve (API, entre fechas) o LayTours (fichero CSV
   para una sociedad). Mientras las APIs no estén configuradas, la opción aparece deshabilitada con el motivo. *@

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6"><MudIcon Icon="@Icons.Material.Filled.CloudDownload" Class="mr-2" />Cargar datos</MudText>
    </TitleContent>
    <DialogContent>
        @if (_resultado is null)
        {
            <MudText Typo="Typo.body2" Class="mb-3 mud-text-secondary">Elige el origen de los datos. La carga es "todo o nada": si hay algún error no se guarda ningún registro.</MudText>
            <MudRadioGroup T="OrigenCarga" @bind-Value="_origen">
                @foreach (var p in _proveedores)
                {
                    <MudRadio T="OrigenCarga" Value="@p.Origen" Color="Color.Primary" Disabled="@(!p.Configurado)">
                        <b>@p.Origen.Codigo()</b> <span class="mud-text-secondary">(API · @p.Detalle)</span>
                    </MudRadio>
                }
                <MudRadio T="OrigenCarga" Value="@OrigenCarga.LayTours" Color="Color.Primary"><b>LayTours</b> <span class="mud-text-secondary">(fichero CSV)</span></MudRadio>
            </MudRadioGroup>

            <MudDivider Class="my-3" />

            @if (_origen == OrigenCarga.LayTours)
            {
                <MudSelect T="int?" @bind-Value="_codPais" Label="Sociedad de los gastos" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="mb-3">
                    @foreach (var s in _sociedades)
                    {
                        <MudSelectItem T="int?" Value="@s.CodPais">@s.Nombre</MudSelectItem>
                    }
                </MudSelect>
                <MudFileUpload T="IBrowserFile" FilesChanged="OnFichero" Accept=".csv,.txt">
                    <ActivatorContent>
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.UploadFile">
                            @(_fichero is null ? "Seleccionar fichero LayTours.csv" : _fichero.Name)
                        </MudButton>
                    </ActivatorContent>
                </MudFileUpload>
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-1">
                    Formato: 9 columnas separadas por ';' (factura; concepto; importe; usuario Epsilon; albarán; detalle; fecha ddMMyyyy; nº días; destino).
                </MudText>
            }
            else
            {
                <MudDateRangePicker @bind-DateRange="_rango" Label="Periodo de movimientos" Variant="Variant.Outlined" Margin="Margin.Dense"
                                    PickerVariant="PickerVariant.Dialog" DateFormat="dd/MM/yyyy" />
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-1">
                    Se piden a la API de @_origen.Codigo() los movimientos del periodo. Los ya cargados se omiten; las tarjetas deben estar dadas de alta.
                </MudText>
            }
            @if (_ejecutando)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-4" />
            }
        }
        else
        {
            <MudAlert Severity="@(_resultado.Ok ? Severity.Success : Severity.Error)" Class="mb-3">@_resultado.Mensaje</MudAlert>
            <MudSimpleTable Dense="true" Elevation="0">
                <tbody>
                    <tr><td>Filas / movimientos leídos</td><td class="text-right">@_resultado.Filas</td></tr>
                    <tr><td>Gastos insertados</td><td class="text-right">@_resultado.Insertados</td></tr>
                    <tr><td>Omitidos (duplicados o sin gasto)</td><td class="text-right">@_resultado.Omitidos</td></tr>
                    <tr><td>Nº de carga</td><td class="text-right">@_resultado.IdCarga</td></tr>
                </tbody>
            </MudSimpleTable>
            @if (_resultado.Avisos.Count > 0)
            {
                <MudExpansionPanels Class="mt-3" Dense="true">
                    <MudExpansionPanel Text="@($"{_resultado.Avisos.Count} aviso(s)")">
                        <div style="max-height:200px;overflow:auto">
                            @foreach (var a in _resultado.Avisos.Take(200)) { <MudText Typo="Typo.caption" Class="d-block">@a</MudText> }
                        </div>
                    </MudExpansionPanel>
                </MudExpansionPanels>
            }
        }
    </DialogContent>
    <DialogActions>
        @if (_resultado is null)
        {
            <MudButton OnClick="@(() => Dialog.Cancel())" Disabled="_ejecutando">Cancelar</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="EjecutarAsync" Disabled="@(_ejecutando || !PuedeEjecutar)">Cargar</MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => Dialog.Close(DialogResult.Ok(_resultado.Ok)))">Cerrar</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance Dialog { get; set; } = default!;

    private List<(OrigenCarga Origen, bool Configurado, string Detalle)> _proveedores = new();
    private List<Sociedad> _sociedades = new();
    private OrigenCarga _origen = OrigenCarga.Repsol;
    private int? _codPais;
    private IBrowserFile? _fichero;
    private DateRange _rango = new(DateTime.Today.AddMonths(-1), DateTime.Today);
    private bool _ejecutando;
    private ResultadoCarga? _resultado;

    private bool PuedeEjecutar => _origen == OrigenCarga.LayTours
        ? _codPais is not null && _fichero is not null
        : _rango?.Start is not null && _rango?.End is not null;

    protected override async Task OnInitializedAsync()
    {
        await Sesion.EnsureLoadedAsync();
        _proveedores = CargaService.EstadoProveedores().ToList();
        // Origen por defecto: el primer proveedor configurado; si no hay ninguno, LayTours.
        _origen = _proveedores.FirstOrDefault(p => p.Configurado).Origen;
        if (!_proveedores.Any(p => p.Configurado)) _origen = OrigenCarga.LayTours;
        try { _sociedades = (await Catalogos.DameSociedadesAsync()).ToList(); }
        catch (Exception ex) { Snackbar.Add($"Error al cargar sociedades: {ex.Message}", Severity.Error); }
    }

    private void OnFichero(IBrowserFile? f) => _fichero = f;

    private async Task EjecutarAsync()
    {
        if (!Sesion.EsAdministrador) { Snackbar.Add("Solo un Administrador puede cargar datos.", Severity.Warning); return; }
        _ejecutando = true;
        try
        {
            if (_origen == OrigenCarga.LayTours)
            {
                await using var stream = _fichero!.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                ms.Position = 0;
                _resultado = await CargaService.CargarLayToursAsync(ms, _codPais!.Value, Sesion.Email, _fichero.Name);
            }
            else
            {
                _resultado = await CargaService.CargarProveedorAsync(_origen, _rango.Start!.Value, _rango.End!.Value, Sesion.Email);
            }
        }
        catch (Exception ex)
        {
            _resultado = ResultadoCarga.Error($"Error inesperado: {ex.Message}");
        }
        finally { _ejecutando = false; }
    }
}
