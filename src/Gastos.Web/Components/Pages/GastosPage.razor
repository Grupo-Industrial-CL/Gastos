@page "/gastos"
@attribute [Authorize]
@inject IGastoService GastoService
@inject SesionUsuario Sesion
@inject ISnackbar Snackbar
@inject IDialogService DialogService

@* Pantalla principal: grid de gastos internos con buscador general (resaltado en amarillo), filtro bajo cada
   columna y exportación a Excel de lo que se ve. El Administrador ve todas las sociedades y dispone del botón
   "Cargar datos"; el Consultor solo ve las sociedades a las que tiene acceso (el filtro se aplica en la consulta). *@

<PageTitle>Gastos</PageTitle>

<div class="d-flex align-center flex-wrap mb-2" style="gap:.75rem">
    <MudText Typo="Typo.h4"><h1 style="all:inherit;margin:0">Gastos</h1></MudText>
    <MudSpacer />
    <MudText Typo="Typo.body2" Class="mud-text-secondary">@_gastos.Count gasto(s)@TotalImporte</MudText>
    <MudButton Variant="Variant.Filled" Size="Size.Small" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="CargarAsync" Disabled="_loading">Refrescar</MudButton>
</div>

<GtGrid T="GastoVista" @ref="_grid" Items="_gastos" Columnas="_cols" Loading="_loading" NombreExport="Gastos"
        TextoVacio="@(_consultado ? "No hay gastos para el periodo seleccionado." : "Selecciona el periodo y pulsa Refrescar.")">
    <ToolbarIzquierda>
        <MudDateRangePicker @bind-DateRange="_rango" Label="Fecha del gasto" Margin="Margin.Dense" Variant="Variant.Outlined"
                            PickerVariant="PickerVariant.Dialog" DateFormat="dd/MM/yyyy" Clearable="true" Class="mt-0" Style="width:320px;min-width:320px" />
    </ToolbarIzquierda>
    <ToolbarDerecha>
        @if (Sesion.EsAdministrador)
        {
            <MudButton Variant="Variant.Filled" Size="Size.Small" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.CloudDownload" OnClick="AbrirCargaAsync">Cargar datos</MudButton>
        }
    </ToolbarDerecha>
</GtGrid>

@code {
    private GtGrid<GastoVista>? _grid;
    private List<GastoVista> _gastos = new();
    private DateRange _rango = new(new DateTime(DateTime.Today.Year, 1, 1), DateTime.Today);
    private bool _loading;
    private bool _consultado;
    private List<GtColumna<GastoVista>> _cols = new();

    private string TotalImporte => _gastos.Count == 0 ? string.Empty : $" · total {_gastos.Sum(g => g.Importe):N2} €";

    protected override async Task OnInitializedAsync()
    {
        _cols = new()
        {
            new() { Titulo = "Sociedad", Valor = x => x.Sociedad, Ancho = "170px" },
            new() { Titulo = "Departamento", Valor = x => x.DepartamentoNombre.Length > 0 ? x.DepartamentoNombre : x.Departamento.ToString(), Ancho = "170px" },
            new() { Titulo = "Empleado", Valor = x => x.Empleado.Length > 0 ? x.Empleado : x.Codigo.ToString(), Ancho = "200px" },
            new() { Titulo = "Fecha", Valor = x => x.Fecha.ToString("dd/MM/yyyy"), Orden = x => x.Fecha, Ancho = "110px", SinEmbudo = true },
            new() { Titulo = "Tipo de gasto", Valor = x => x.TipoGastoNombre, Ancho = "140px" },
            new() { Titulo = "Concepto / lugar", Valor = x => x.Donde, Ancho = "260px", SinEmbudo = true },
            new() { Titulo = "Importe", Valor = x => x.Importe.ToString("N2"), Orden = x => x.Importe, Numero = x => (double)x.Importe, FiltroNumerico = true, SinEmbudo = true, Derecha = true, Ancho = "110px" },
            new() { Titulo = "Moneda", Valor = x => x.Moneda, Ancho = "80px" },
            new() { Titulo = "Factura", Valor = x => x.Factura ?? string.Empty, Ancho = "130px", SinEmbudo = true },
            new() { Titulo = "Origen", Valor = x => x.Origen ?? string.Empty, Ancho = "100px",
                    Plantilla = item => @<MudChip T="string" Size="Size.Small" Color="@ColorOrigen(item.Origen)">@(item.Origen ?? "-")</MudChip> },
            new() { Titulo = "Validado", Valor = x => x.Validado == "S" ? "Sí" : "No", Ancho = "90px" },
            new() { Titulo = "Pagado", Valor = x => x.Pagado == "S" ? "Sí" : "No", Ancho = "90px" },
            new() { Titulo = "SAP", Valor = x => x.ContaSAP == "S" ? "Sí" : "No", Ancho = "80px" },
            new() { Titulo = "Fecha carga", Valor = x => x.FechaInsert?.ToString("dd/MM/yyyy HH:mm") ?? string.Empty, Orden = x => x.FechaInsert ?? DateTime.MinValue, Ancho = "140px", SinEmbudo = true },
        };

        await Sesion.EnsureLoadedAsync();
        await CargarAsync();
    }

    private static Color ColorOrigen(string? o) => o switch
    {
        "Repsol" => Color.Warning,
        "Moeve" => Color.Info,
        "LayTours" => Color.Tertiary,
        _ => Color.Default
    };

    private async Task CargarAsync()
    {
        _loading = true;
        try
        {
            // Barrera de seguridad: el Administrador consulta sin filtro de sociedad (null); el Consultor SIEMPRE con sus permitidas.
            _gastos = (await GastoService.DameGastosAsync(Sesion.SociedadesVisibles, _rango?.Start, _rango?.End)).ToList();
            _consultado = true;
        }
        catch (Exception ex) { Snackbar.Add($"Error al consultar los gastos: {ex.Message}", Severity.Error); }
        finally { _loading = false; }
    }

    private async Task AbrirCargaAsync()
    {
        if (!Sesion.EsAdministrador) return;
        var dlg = await DialogService.ShowAsync<CargarDatosDialog>("Cargar datos",
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true });
        var res = await dlg.Result;
        if (res is { Canceled: false }) await CargarAsync();
    }
}
