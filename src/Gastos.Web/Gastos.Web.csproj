<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Gastos.Web</RootNamespace>
    <AssemblyName>Gastos.Web</AssemblyName>
    <UserSecretsId>gastos-web</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Interfaz Blazor Server con MudBlazor y autenticación Azure AD / Entra ID (mismas versiones que MasterPlan v2) -->
    <PackageReference Include="MudBlazor" Version="7.15.0" />
    <PackageReference Include="Microsoft.Identity.Web" Version="3.8.2" />
    <PackageReference Include="Microsoft.Identity.Web.UI" Version="3.8.2" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="8.0.11" />
  </ItemGroup>

  <!-- Overrides de seguridad (NuGet audit): versiones parcheadas de transitivas vulnerables -->
  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="8.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gastos.Domain\Gastos.Domain.csproj" />
    <ProjectReference Include="..\Gastos.Data\Gastos.Data.csproj" />
    <ProjectReference Include="..\Gastos.Business\Gastos.Business.csproj" />
  </ItemGroup>

</Project>
